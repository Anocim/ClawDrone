          <material><ambient>0.94 0.94 0.90 1</ambient><diffuse>0.94 0.94 0.90 1</diffuse></material>
        </visual>
        <visual name="center_mark_negative_x">
          <pose>-11.7850 0.0000 0.0060 0 0 0</pose>
          <geometry><box><size>0.2000 0.0500 0.0080</size></box></geometry>
          <material><ambient>0.94 0.94 0.90 1</ambient><diffuse>0.94 0.94 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

