<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="f550_base">
    <link name="base_link">
      <visual name="lower_central_board_visual">
        <pose>0 0 -0.05 0 0 0.5235987755982988</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_central_board.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/DarkGrey</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="upper_central_board_visual">
        <pose>0 0 -0.012 0 0 0.5235987755982988</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_central_board.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/DarkGrey</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="front_right_arm_visual">
        <pose>0.09526 -0.055 -0.012 0 0 -0.5235987755982988</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_arm.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="middle_right_arm_visual">
        <pose>0 -0.11 -0.012 0 0 -1.5707963267948966</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_arm.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="back_right_arm_visual">
        <pose>-0.09526 -0.055 -0.012 0 0 -2.6179938779914944</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_arm.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/Red</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="front_left_arm_visual">
        <pose>0.09526 0.055 -0.012 0 0 0.5235987755982988</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_arm.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="middle_left_arm_visual">
        <pose>0 0.11 -0.012 0 0 1.5707963267948966</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_arm.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="back_left_arm_visual">
        <pose>-0.09526 0.055 -0.012 0 0 2.6179938779914944</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_arm.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/Red</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="NUC_visual">
        <pose>0 0 0.023 0 0 0</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_nuc.dae</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><script><name>Gazebo/DarkGrey</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>
      <visual name="pixhawk_visual">
        <pose>0 0 -0.0425 0 0 0</pose>
        <geometry><mesh><uri>model://mrs_robots_description/meshes/sensors/pixhawk.dae</uri><scale>1 1 1</scale></mesh></geometry>
        <material><script><name>Gazebo/DarkGrey</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
      </visual>

      <inertial>
        <mass>2.0</mass>
        <inertia><ixx>0.0316</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0316</iyy><iyz>0</iyz><izz>0.0625</izz></inertia>
      </inertial>
      <collision name="base_link_collision">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><cylinder><length>0.1</length><radius>0.3</radius></cylinder></geometry>
      </collision>

      <sensor name="air_pressure_sensor" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><air_pressure><pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure></air_pressure></sensor>
      <sensor name="magnetometer_sensor" type="magnetometer"><always_on>1</always_on><update_rate>100</update_rate><magnetometer><x><noise type="gaussian"><stddev>1e-7</stddev></noise></x><y><noise type="gaussian"><stddev>1e-7</stddev></noise></y><z><noise type="gaussian"><stddev>1e-7</stddev></noise></z></magnetometer></sensor>
      <sensor name="navsat_sensor" type="navsat"><always_on>1</always_on><update_rate>10</update_rate></sensor>
      <sensor name="imu_sensor" type="imu"><always_on>1</always_on><update_rate>250</update_rate><imu><angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></z></angular_velocity><linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.00686</stddev></noise></z></linear_acceleration></imu></sensor>
    </link>

    <!-- Propellers and joints (prop_0_link to prop_5_link) -->
    <link name="prop_0_link"><pose>0 -0.275 0.0115 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>1.74e-05</ixx><iyy>1.74e-05</iyy><izz>3.48e-05</izz></inertia></inertial><visual name="p0"><geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_prop.dae</uri><scale>-1 1 1</scale></mesh></geometry></visual><collision name="prop_0_collision"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><length>0.236</length><radius>0.01</radius></cylinder></geometry></collision></link>
    <joint name="prop_0_joint" type="revolute"><parent>base_link</parent><child>prop_0_link</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="prop_1_link"><pose>0 0.275 0.0115 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>1.74e-05</ixx><iyy>1.74e-05</iyy><izz>3.48e-05</izz></inertia></inertial><visual name="p1"><geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_prop.dae</uri><scale>1 1 1</scale></mesh></geometry></visual><collision name="prop_1_collision"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><length>0.236</length><radius>0.01</radius></cylinder></geometry></collision></link>
    <joint name="prop_1_joint" type="revolute"><parent>base_link</parent><child>prop_1_link</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="prop_2_link"><pose>0.23815 0.1375 0.0115 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>1.74e-05</ixx><iyy>1.74e-05</iyy><izz>3.48e-05</izz></inertia></inertial><visual name="p2"><geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_prop.dae</uri><scale>-1 1 1</scale></mesh></geometry></visual><collision name="prop_2_collision"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><length>0.236</length><radius>0.01</radius></cylinder></geometry></collision></link>
    <joint name="prop_2_joint" type="revolute"><parent>base_link</parent><child>prop_2_link</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="prop_3_link"><pose>-0.23815 -0.1375 0.0115 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>1.74e-05</ixx><iyy>1.74e-05</iyy><izz>3.48e-05</izz></inertia></inertial><visual name="p3"><geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_prop.dae</uri><scale>1 1 1</scale></mesh></geometry></visual><collision name="prop_3_collision"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><length>0.236</length><radius>0.01</radius></cylinder></geometry></collision></link>
    <joint name="prop_3_joint" type="revolute"><parent>base_link</parent><child>prop_3_link</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="prop_4_link"><pose>0.23815 -0.1375 0.0115 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>1.74e-05</ixx><iyy>1.74e-05</iyy><izz>3.48e-05</izz></inertia></inertial><visual name="p4"><geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_prop.dae</uri><scale>1 1 1</scale></mesh></geometry></visual><collision name="prop_4_collision"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><length>0.236</length><radius>0.01</radius></cylinder></geometry></collision></link>
    <joint name="prop_4_joint" type="revolute"><parent>base_link</parent><child>prop_4_link</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="prop_5_link"><pose>-0.23815 0.1375 0.0115 0 0 0</pose><inertial><mass>0.005</mass><inertia><ixx>1.74e-05</ixx><iyy>1.74e-05</iyy><izz>3.48e-05</izz></inertia></inertial><visual name="p5"><geometry><mesh><uri>model://mrs_robots_description/meshes/dji/f550/dji_f550_prop.dae</uri><scale>-1 1 1</scale></mesh></geometry></visual><collision name="prop_5_collision"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><length>0.236</length><radius>0.01</radius></cylinder></geometry></collision></link>
    <joint name="prop_5_joint" type="revolute"><parent>base_link</parent><child>prop_5_link</child><axis><xyz>0 0 1</xyz></axis></joint>
  </model>
