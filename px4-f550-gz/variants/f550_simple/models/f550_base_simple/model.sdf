<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="f550_base">
    <pose>0 0 0.15 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia><ixx>0.023</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.023</iyy><iyz>0</iyz><izz>0.044</izz></inertia>
      </inertial>
      
      <!-- Cuerpo Central -->
      <visual name="center_plate">
        <geometry><cylinder><radius>0.09</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="battery">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.14 0.045 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.35 1</ambient><diffuse>0.1 0.1 0.35 1</diffuse></material>
      </visual>
      
      <!-- Brazos -->
      <visual name="arm_0"><pose>0.1451 0.0837 0 0 0 0.5236</pose><geometry><box><size>0.215 0.03 0.02</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <visual name="arm_1"><pose>0 0.1675 0 0 0 1.5708</pose><geometry><box><size>0.215 0.03 0.02</size></box></geometry><material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual>
      <visual name="arm_2"><pose>-0.1451 0.0837 0 0 0 2.6180</pose><geometry><box><size>0.215 0.03 0.02</size></box></geometry><material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual>
      <visual name="arm_3"><pose>-0.1451 -0.0838 0 0 0 3.6652</pose><geometry><box><size>0.215 0.03 0.02</size></box></geometry><material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual>
      <visual name="arm_4"><pose>0 -0.1675 0 0 0 4.7124</pose><geometry><box><size>0.215 0.03 0.02</size></box></geometry><material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual>
      <visual name="arm_5"><pose>0.1451 -0.0838 0 0 0 5.7596</pose><geometry><box><size>0.215 0.03 0.02</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      
      <!-- Patas -->
      <visual name="leg_0"><pose>0.12 0.12 -0.07 0 0 0</pose><geometry><box><size>0.015 0.015 0.14</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="leg_1"><pose>0.12 -0.12 -0.07 0 0 0</pose><geometry><box><size>0.015 0.015 0.14</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="leg_2"><pose>-0.12 0.12 -0.07 0 0 0</pose><geometry><box><size>0.015 0.015 0.14</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="leg_3"><pose>-0.12 -0.12 -0.07 0 0 0</pose><geometry><box><size>0.015 0.015 0.14</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>

      <collision name="base_col"><geometry><box><size>0.2 0.2 0.05</size></box></geometry></collision>
      
      <!-- Sensores -->
      <sensor name="air_pressure_sensor" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><air_pressure><pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure></air_pressure></sensor>
      <sensor name="magnetometer_sensor" type="magnetometer"><always_on>1</always_on><update_rate>100</update_rate><magnetometer><x><noise type="gaussian"><stddev>3e-7</stddev></noise></x><y><noise type="gaussian"><stddev>3e-7</stddev></noise></y><z><noise type="gaussian"><stddev>3e-7</stddev></noise></z></magnetometer></sensor>
      <sensor name="imu_sensor" type="imu"><always_on>1</always_on><update_rate>250</update_rate><imu><angular_velocity><x><noise type="gaussian"><mean>0.0</mean><stddev>0.00087</stddev></noise></x><y><noise type="gaussian"><mean>0.0</mean><stddev>0.00087</stddev></noise></y><z><noise type="gaussian"><mean>0.0</mean><stddev>0.00087</stddev></noise></z></angular_velocity><linear_acceleration><x><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></x><y><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></y><z><noise type="gaussian"><mean>0.0</mean><stddev>0.00686</stddev></noise></z></linear_acceleration></imu></sensor>
      <sensor name="navsat_sensor" type="navsat"><always_on>1</always_on><update_rate>30</update_rate></sensor>
    </link>

    <!-- Rotores y Motores -->
    <link name="rotor_0"><pose>0.2382 -0.1375 0.045 0 0 0</pose>
      <inertial><mass>0.016</mass><inertia><ixx>3.84e-07</ixx><iyy>2.61e-05</iyy><izz>2.64e-05</izz></inertia></inertial>
      <visual name="p0_prop"><geometry><box><size>0.24 0.02 0.003</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="p0_motor"><pose>0 0 -0.02 0 0 0</pose><geometry><cylinder><radius>0.0175</radius><length>0.03</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link>
    <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="rotor_1"><pose>0 -0.2750 0.045 0 0 0</pose>
      <inertial><mass>0.016</mass><inertia><ixx>3.84e-07</ixx><iyy>2.61e-05</iyy><izz>2.64e-05</izz></inertia></inertial>
      <visual name="p1_prop"><geometry><box><size>0.24 0.02 0.003</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="p1_motor"><pose>0 0 -0.02 0 0 0</pose><geometry><cylinder><radius>0.0175</radius><length>0.03</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link>
    <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="rotor_2"><pose>-0.2382 -0.1375 0.045 0 0 0</pose>
      <inertial><mass>0.016</mass><inertia><ixx>3.84e-07</ixx><iyy>2.61e-05</iyy><izz>2.64e-05</izz></inertia></inertial>
      <visual name="p2_prop"><geometry><box><size>0.24 0.02 0.003</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="p2_motor"><pose>0 0 -0.02 0 0 0</pose><geometry><cylinder><radius>0.0175</radius><length>0.03</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link>
    <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="rotor_3"><pose>-0.2382 0.1375 0.045 0 0 0</pose>
      <inertial><mass>0.016</mass><inertia><ixx>3.84e-07</ixx><iyy>2.61e-05</iyy><izz>2.64e-05</izz></inertia></inertial>
      <visual name="p3_prop"><geometry><box><size>0.24 0.02 0.003</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="p3_motor"><pose>0 0 -0.02 0 0 0</pose><geometry><cylinder><radius>0.0175</radius><length>0.03</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link>
    <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="rotor_4"><pose>0 0.2750 0.045 0 0 0</pose>
      <inertial><mass>0.016</mass><inertia><ixx>3.84e-07</ixx><iyy>2.61e-05</iyy><izz>2.64e-05</izz></inertia></inertial>
      <visual name="p4_prop"><geometry><box><size>0.24 0.02 0.003</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="p4_motor"><pose>0 0 -0.02 0 0 0</pose><geometry><cylinder><radius>0.0175</radius><length>0.03</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link>
    <joint name="rotor_4_joint" type="revolute"><parent>base_link</parent><child>rotor_4</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="rotor_5"><pose>0.2382 0.1375 0.045 0 0 0</pose>
      <inertial><mass>0.016</mass><inertia><ixx>3.84e-07</ixx><iyy>2.61e-05</iyy><izz>2.64e-05</izz></inertia></inertial>
      <visual name="p5_prop"><geometry><box><size>0.24 0.02 0.003</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="p5_motor"><pose>0 0 -0.02 0 0 0</pose><geometry><cylinder><radius>0.0175</radius><length>0.03</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link>
